    {
      "id": 9,
      "type": "table",
      "title": "Firing alerts",
      "description": "Everything vmalert has firing right now, except the always-on meta alerts.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "ALERTS{alertstate=\"firing\", alertname!~\"Watchdog|InfoInhibitor\"}",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "cluster": true,
              "prometheus": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "pod": true,
              "service": true,
              "container": true,
              "alertstate": true
            },
            "indexByName": {
              "severity": 0,
              "alertname": 1,
              "namespace": 2,
              "Value": 3
            },
            "renameByName": {
              "severity": "Severity",
              "alertname": "Alert",
              "namespace": "Namespace"
            },
            "includeByName": {
              "severity": true,
              "alertname": true,
              "namespace": true,
              "Value": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No alerts firing",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Severity",
            "desc": false
          }
        ]
      }
    },
    {
