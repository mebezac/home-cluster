    {
      "id": 7,
      "type": "stat",
      "title": "Oldest backup",
      "description": "Age of the oldest latest-backup across Longhorn volumes and the central Postgres cluster. Daily jobs: over 30h is late, over 36h alerts.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(time() - longhorn_volume_last_backup_at > 0 and longhorn_volume_last_backup_at > 0) > max(time() - barman_cloud_cloudnative_pg_io_last_available_backup_timestamp{namespace=\"database\"}) or max(time() - barman_cloud_cloudnative_pg_io_last_available_backup_timestamp{namespace=\"database\"})",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "0",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 108000
              },
              {
                "color": "#d03b3b",
                "value": 129600
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
