          "expr": "label_replace(label_replace(instance:node_cpu_utilisation:rate5m * on(instance) group_left(nodename) node_uname_info, \"nodename\", \"wyse-$1\", \"nodename\", \"wyse-5070-0([0-9])-.*\"), \"nodename\", \"elitebook-$1\", \"nodename\", \"elitebook-0([0-9])-.*\")",
