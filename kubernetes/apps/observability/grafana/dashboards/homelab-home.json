    {
      "id": 6,
      "type": "row",
      "title": "Devices",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Batteries (lowest first)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 10,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort(hass_sensor_battery_percent)",
          "legendFormat": "{{friendly_name}}",
          "refId": "A",
          "range": false,
          "instant": true
