    {
      "id": 11,
      "type": "table",
      "title": "Unavailable entities",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 10,
        "y": 23,
        "w": 14,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "hass_entity_available == 0",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "cluster": true,
              "prometheus": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "pod": true,
              "service": true,
              "container": true,
              "alertstate": true
            },
            "indexByName": {
              "friendly_name": 0,
              "entity": 1,
              "domain": 2
            },
            "renameByName": {
              "friendly_name": "Name",
              "entity": "Entity",
              "domain": "Domain"
            },
            "includeByName": {
              "friendly_name": true,
              "entity": true,
              "domain": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Every entity is available",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": []
      }
    },
