                "color": "#fab219",
                "value": 15
              },
              {
                "color": "#3987e5",
                "value": 30
              }
            ]
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "text",
        "namePlacement": "left",
        "sizing": "auto",
        "minVizHeight": 14,
        "maxVizHeight": 22,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Unavailable entities",
      "description": "Entities HA marks unavailable (device offline or integration down).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 10,
        "y": 19,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(hass_entity_available == 0) or vector(0)",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
