      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(node_disk_read_time_seconds_total{job=\"hh-chi-10tb\", device!~\"loop.*|ram.*|sr.*|fd.*\"}[$__rate_interval]) / rate(node_disk_reads_completed_total{job=\"hh-chi-10tb\", device!~\"loop.*|ram.*|sr.*|fd.*\"}[$__rate_interval])",
