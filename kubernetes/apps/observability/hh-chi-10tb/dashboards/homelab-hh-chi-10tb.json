          "expr": "sum(rate(node_cpu_seconds_total{job=\"hh-chi-10tb\", mode=\"iowait\"}[5m])) / count(node_cpu_seconds_total{job=\"hh-chi-10tb\", mode=\"idle\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
