{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    ":automergeBranch",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":semanticCommits",
    ":separatePatchReleases",
  ],
  dependencyDashboard: {
    enabled: true,
    title: "Renovate Dashboard 🤖",
  },
  suppressNotifications: ["prEditedNotification", "prIgnoreNotification"],
  // Commits the workflows push to Renovate branches (n8n-runners-sync): Renovate keeps
  // rebasing such a branch instead of treating it as edited by hand.
  gitIgnoredAuthors: ["41898282+github-actions[bot]@users.noreply.github.com"],
  schedule: ["every weekend"],
  ignorePaths: ["**/*.sops.*"],
  argocd: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  helmfile: {
    managerFilePatterns: ["/(^|/)helmfile\\.ya?ml(?:\\.j2)?$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  kustomize: {
    managerFilePatterns: ["/(^|/)kustomization\\.ya?ml(?:\\.j2)?$/"],
  },
  pip_requirements: {
    managerFilePatterns: [
      "/(^|/)[\\w-]*requirements(-\\w+)?\\.(txt|pip)(?:\\.j2)?$/",
    ],
  },
  packageRules: [
    {
      description: ["Auto-merge GitHub Actions for minor and patch"],
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
      matchUpdateTypes: ["minor", "patch"],
    },
    {
      description: [
        "Argo Operator Group",
        "github-releases pulls in the argocd CLI (aqua:argoproj/argo-cd in .mise.toml) so it tracks the server.",
      ],
      groupName: "Argo Operator",
      matchDatasources: ["docker", "github-releases"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: ["/argo-cd/", "quay.io/argoproj/argocd"],
    },
    {
      description: [
        "Talos Group",
        "github-tags pulls in talosctl (aqua:siderolabs/talos in .mise.toml): Renovate resolves aqua tools via github-tags.",
      ],
      groupName: "Talos",
      matchDatasources: ["docker", "github-releases", "github-tags"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: ["/siderolabs/talosctl/", "/siderolabs/installer/", "/siderolabs/talos/"],
    },
    {
      description: [
        "Barman Cloud Plugin Group",
        "Our image tags override the chart appVersion, and the plugin and its injected sidecar talk gRPC,",
        "so the chart and both images (plugin + sidecar) land in one PR.",
      ],
      groupName: "Barman Cloud Plugin",
      matchDatasources: ["docker", "helm"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: ["/plugin-barman-cloud/"],
    },
    {
      description: [
        "silence-operator Group",
        "Our image tag (values.yaml, regex manager below) overrides the chart appVersion; they are the",
        "same version, so the chart and the image land in one PR.",
      ],
      groupName: "silence-operator",
      matchDatasources: ["docker", "helm"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: ["/silence-operator/"],
    },
    {
      description: [
        "Kubernetes Group",
        "kubelet (topf.yaml kubernetesVersion), the kubectl client and the registry.k8s.io/kubectl image (oCIS cleanup CronJob) move together, as in commit 1ac21971.",
        "Merging does NOT upgrade the cluster - run `task talos:upgrade-k8s` (dry-run first) before any topf apply.",
      ],
      groupName: "Kubernetes",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: ["/siderolabs/kubelet/", "aqua:kubernetes/kubectl", "registry.k8s.io/kubectl"],
    },
    {
      description: [
        "Hold the local mise node on an LTS that npm:renovate (renovate-config-validator) supports: engines ^24.22.3 || ^26.13.1 since 45.0.0.",
        "The same node runs npx for the MCP servers (.mcp.json): handshake-test them on the node major PR. Neither declares engines.",
        "Container base images (containers/*/Dockerfile) still get node majors. Raise this when renovate's engines include the next LTS (28).",
      ],
      matchManagers: ["mise"],
      matchDepNames: ["node"],
      allowedVersions: "<27",
    },
    {
      description: [
        "n8n publishes its beta channel as plain semver docker tags (GH pre-releases only), so Renovate",
        "cannot tell beta from stable. A new minor goes GH 'Latest' 3-8 days after its .0 (2.36-2.44),",
        "so hold every n8n version for 10 days. Needs Docker Hub (n8nio/n8n): ghcr has no publish dates.",
        "Caveat: the newest aged version can be an old beta patch of a now-stable minor - check in triage.",
      ],
      groupName: "n8n",
      matchDatasources: ["docker"],
      matchPackageNames: ["n8nio/n8n", "docker.io/n8nio/n8n"],
      minimumReleaseAge: "10 days",
      internalChecksFilter: "strict",
    },
    {
      description: [
        "n8nio/runners must carry exactly the n8n version, but on the Mend app it gets no Docker Hub",
        "release timestamps, so the age gate held every runners version and the n8n PR left it behind",
        "(#2935). Renovate does not update runners; .github/workflows/n8n-runners-sync.yaml sets it to",
        "the n8n version on each Renovate n8n PR (gitIgnoredAuthors keeps Renovate rebasing that branch).",
      ],
      matchDatasources: ["docker"],
      matchPackageNames: ["n8nio/runners", "docker.io/n8nio/runners"],
      enabled: false,
    },
    {
      description: [
        "Envoy Gateway Group",
        "Envoy Gateway bundles a specific Gateway API version; kubernetes-sigs/gateway-api",
        "(gateway-api-crds app) must match it, so both charts and the CRDs land in one PR.",
        "Before merging, check the EG release notes for the bundled Gateway API version.",
      ],
      groupName: "Envoy Gateway",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: ["/envoyproxy/gateway-helm/", "/envoyproxy/gateway-crds-helm/", "kubernetes-sigs/gateway-api"],
    },
    {
      description: [
        "The group above still opens a lone gateway-api PR when EG has no update (#2572: v1.6.3 while",
        "EG v1.9.2 bundled v1.6.1). Gate it: approve on the Dependency Dashboard only once an EG release",
        "bundles that version. Approval is per branch, so a combined EG+gateway-api PR waits too; an",
        "EG-only bump still opens normally.",
      ],
      matchPackageNames: ["kubernetes-sigs/gateway-api"],
      dependencyDashboardApproval: true,
    },
    {
      description: [
        "The argocd manager also reads gateway-api-crds.yaml (git repoURL + targetRevision) under the",
        "depName https://github.com/kubernetes-sigs/gateway-api, which opens a duplicate PR that escapes",
        "the Envoy Gateway group. The `# renovate:` regex comment in that file is the one source of truth.",
      ],
      matchManagers: ["argocd"],
      matchFileNames: ["kubernetes/argo/apps/kube-system/gateway-api-crds.yaml"],
      enabled: false,
    },
    {
      description: [
        "Intel Device Plugins Group",
        "operator >=0.37.1 rejects a plugin image older than itself, so a lone operator bump fails the sync.",
      ],
      groupName: "Intel Device Plugins",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: [
        "intel-device-plugins-operator",
        "intel-device-plugins-gpu",
        "intel/intel-deviceplugin-operator",
        "intel/intel-gpu-plugin",
      ],
    },
    {
      description: [
        "cert-manager Group",
        "Chart-default images pinned with a digest in our values (2026-11-28): the chart and its images must move in one PR, or the chart bump keeps the old image.",
      ],
      groupName: "cert-manager",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: [
        "cert-manager",
        "/^quay\\.io/jetstack/cert-manager-/",
      ],
    },
    {
      description: [
        "CloudNativePG Operator Group",
        "Chart-default images pinned with a digest in our values (2026-11-28): the chart and its images must move in one PR, or the chart bump keeps the old image. Exact names: /cloudnative-pg/ would also catch the postgresql images and the barman plugin.",
      ],
      groupName: "CloudNativePG Operator",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: [
        "cloudnative-pg",
        "ghcr.io/cloudnative-pg/cloudnative-pg",
      ],
    },
    {
      description: [
        "Longhorn Group",
        "Chart-default images pinned with a digest in our values (2026-11-28): the chart and its images must move in one PR, or the chart bump keeps the old image. The engine and instance-manager images stay chart defaults on purpose (a changed string forces volume engine upgrades).",
      ],
      groupName: "Longhorn",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: [
        "longhorn",
        "/^longhornio//",
      ],
    },
    {
      description: [
        "VictoriaMetrics Stack Group",
        "Chart-default images pinned with a digest in our values (2026-11-28): the chart and its images must move in one PR, or the chart bump keeps the old image.",
      ],
      groupName: "VictoriaMetrics Stack",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchFileNames: ["kubernetes/argo/apps/observability/victoria-metrics-stack.yaml", "kubernetes/apps/observability/victoria-metrics-stack/values.yaml"],
      matchPackageNames: [
        "victoria-metrics-k8s-stack",
        "victoriametrics/operator",
        "victoriametrics/vmagent",
        "victoriametrics/vmalert",
        "victoriametrics/victoria-metrics",
        "prom/alertmanager",
        "quay.io/prometheus/node-exporter",
        "registry.k8s.io/kube-state-metrics/kube-state-metrics",
        "ghcr.io/victoriametrics/sync-job",
      ],
    },
    {
      description: [
        "Tailscale Operator Group",
        "Chart-default images pinned with a digest in our values (2026-11-28): the chart and its images must move in one PR, or the chart bump keeps the old image. Exact names: ghcr.io/tailscale/tailscale (rustdesk, tofu-tailscale) is not part of it.",
      ],
      groupName: "Tailscale Operator",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: [
        "tailscale-operator",
        "tailscale/k8s-operator",
        "tailscale/tailscale",
      ],
    },
    {
      description: [
        "Node Feature Discovery Group",
        "Chart-default images pinned with a digest in our values (2026-11-28): the chart and its images must move in one PR, or the chart bump keeps the old image.",
      ],
      groupName: "Node Feature Discovery",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: [
        "node-feature-discovery",
        "registry.k8s.io/nfd/node-feature-discovery",
      ],
    },
    {
      description: [
        "CoreDNS Group",
        "Chart-default images pinned with a digest in our values (2026-11-28): the chart and its images must move in one PR, or the chart bump keeps the old image.",
      ],
      groupName: "CoreDNS",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: [
        "coredns",
        "coredns/coredns",
      ],
    },
    {
      description: [
        "metrics-server Group",
        "Chart-default images pinned with a digest in our values (2026-11-28): the chart and its images must move in one PR, or the chart bump keeps the old image.",
      ],
      groupName: "metrics-server",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: [
        "metrics-server",
        "registry.k8s.io/metrics-server/metrics-server",
      ],
    },
    {
      description: [
        "Reloader Group",
        "Chart-default images pinned with a digest in our values (2026-11-28): the chart and its images must move in one PR, or the chart bump keeps the old image.",
      ],
      groupName: "Reloader",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: [
        "reloader",
        "ghcr.io/stakater/reloader",
      ],
    },
    {
      description: [
        "snapshot-controller Group",
        "Chart-default images pinned with a digest in our values (2026-11-28): the chart and its images must move in one PR, or the chart bump keeps the old image.",
      ],
      groupName: "snapshot-controller",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: [
        "snapshot-controller",
        "registry.k8s.io/sig-storage/snapshot-controller",
      ],
    },
    {
      description: [
        "csi-driver-smb Group",
        "Chart-default images pinned with a digest in our values (2026-11-28): the chart and its images must move in one PR, or the chart bump keeps the old image. Scoped by file: democratic-csi uses the same sig-storage sidecars at other versions.",
      ],
      groupName: "csi-driver-smb",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchFileNames: ["kubernetes/argo/apps/kube-system/csi-driver-smb.yaml", "kubernetes/apps/kube-system/csi-driver-smb/values.yaml"],
      matchPackageNames: [
        "csi-driver-smb",
        "/^registry\\.k8s\\.io/sig-storage//",
      ],
    },
    {
      description: [
        "democratic-csi Group",
        "Chart-default images pinned with a digest in our values (2026-11-28): the chart and its images must move in one PR, or the chart bump keeps the old image. Scoped by file: csi-driver-smb uses the same sig-storage sidecars at other versions.",
      ],
      groupName: "democratic-csi",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchFileNames: ["kubernetes/argo/apps/storage/democratic-csi-nfs.yaml", "kubernetes/argo/apps/storage/democratic-csi-nfs-fast.yaml", "kubernetes/apps/storage/democratic-csi-nfs/values.yaml", "kubernetes/apps/storage/democratic-csi-nfs-fast/values.yaml"],
      matchPackageNames: [
        "democratic-csi",
        "/^registry\\.k8s\\.io/sig-storage//",
        "docker.io/democraticcsi/csi-grpc-proxy",
        "docker.io/democraticcsi/democratic-csi",
        "docker.io/busybox",
      ],
    },
    {
      description: [
        "VictoriaMetrics operator config-reloader image: same repository as the operator, tags config-reloader-vX.Y.Z.",
        "Docker versioning cannot read that prefix, so it would never update.",
      ],
      matchPackageNames: ["victoriametrics/operator"],
      matchCurrentValue: "/^config-reloader-v/",
      versioning: "regex:^config-reloader-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      description: ["Network Optimizer Group", "network-optimizer and speedtest ship in lockstep from one compose file."],
      groupName: "Network Optimizer",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: ["/ozark-connect/"],
    },
    {
      description: [
        "VictoriaLogs Group",
        "The server and vlagent images are pinned in values.yaml, so chart bumps no longer move them;",
        "keep both charts and both images on one VictoriaLogs version.",
      ],
      groupName: "VictoriaLogs",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: ["victoria-logs-single", "victoria-logs-collector", "/victoriametrics/victoria-logs/", "/victoriametrics/vlagent/"],
    },
    {
      description: [
        "External DNS Group",
        "The image is pinned in all three external-dns values.yaml, so chart bumps no longer move it.",
      ],
      groupName: "External DNS",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: ["external-dns", "/external-dns/external-dns/"],
    },
    {
      description: [
        "Kubelet CSR Approver Group",
        "The image is pinned in values.yaml, so chart bumps no longer move it.",
      ],
      groupName: "Kubelet CSR Approver",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: ["kubelet-csr-approver", "/postfinance/kubelet-csr-approver/"],
    },
    {
      description: [
        "Forgejo Runner Group",
        "Keep the forgejo-runner chart, runner image and runner-k8s-plugin sidecar moving in lockstep.",
      ],
      groupName: "Forgejo Runner",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: [
        "data.forgejo.org/forgejo/runner",
        "/eleboucher/runner-k8s-plugin/",
        "/eleboucher/charts/forgejo-runner/",
      ],
    },
    {
      description: [
        "Renovate Operator Group",
        "Keep the renovate-operator chart (CRDs + RBAC) and pinned image moving together.",
      ],
      groupName: "Renovate Operator",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: [
        "/mogenius/helm-charts/renovate-operator/",
        "/mogenius/renovate-operator/",
      ],
    },
    {
      description: [
        "Kopiur Group",
        "Keep the kopiur chart and kubectl-kopiur CLI (.mise.toml) moving in lockstep.",
      ],
      groupName: "Kopiur",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: [
        "/home-operations/charts/kopiur/",
        "github:home-operations/kopiur",
        "home-operations/kopiur",
      ],
    },
    {
      matchDatasources: ["docker"],
      matchUpdateTypes: ["major"],
      commitMessagePrefix: "feat(container)!: ",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: " ( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      semanticCommitScope: "container",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["docker"],
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      semanticCommitScope: "container",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      semanticCommitType: "chore",
      semanticCommitScope: "container",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentDigestShort}} → {{newDigestShort}} )",
    },
    {
      matchDatasources: ["helm"],
      matchUpdateTypes: ["major"],
      commitMessagePrefix: "feat(helm)!: ",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["helm"],
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      semanticCommitScope: "helm",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["helm"],
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      semanticCommitScope: "helm",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["github-releases", "github-tags"],
      matchUpdateTypes: ["major"],
      commitMessagePrefix: "feat(github-release)!: ",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["github-releases", "github-tags"],
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      semanticCommitScope: "github-release",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["github-releases", "github-tags"],
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      semanticCommitScope: "github-release",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["major"],
      commitMessagePrefix: "feat(github-action)!: ",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      semanticCommitScope: "github-action",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      semanticCommitScope: "github-action",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchUpdateTypes: ["major"],
      labels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      labels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      labels: ["type/patch"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchDatasources: ["github-releases", "github-tags"],
      addLabels: ["renovate/github-release"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      description: [
        "Override versioning for Jellyfin: since 12.0 the release tags have two parts (12.4), and docker",
        "versioning does not compare them with the old three-part tags (10.11.11), so no PR opened for 12.x.",
        "The regex takes MAJOR.MINOR with an optional .PATCH. It skips the date builds (2024030404), the",
        "-rc tags, the per-arch tags (-amd64) and the four-part packaging tags (10.11.11.0-1).",
      ],
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/jellyfin/jellyfin", "jellyfin/jellyfin", "docker.io/jellyfin/jellyfin"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(\\.(?<patch>\\d+))?$",
    },
    {
      description: [
        "Override versioning for the immich postgres compound tag",
        "Tag shape: <pgmajor>-vectorchord<x.y.z>-pgvector<a.b.c>, e.g. 18-vectorchord0.5.3-pgvector0.8.1.",
        "Default docker versioning cannot parse this, so Renovate silently offered nothing at all.",
        "compatibility = the Postgres major. Renovate NEVER changes a compatibility value, so this",
        "  pins us to PG 18 and cannot propose an 18 -> 19 jump, which would need a pg_upgrade.",
        "major/minor/patch = the vectorchord version (the component that actually moves).",
        "build/revision = pgvector minor/patch. CAVEAT: pgvector's major is matched but not",
        "  captured because only two slots are left; it has always been 0. If pgvector ever ships",
        "  1.0.0, revisit this rule - ordering across that boundary would be wrong.",
      ],
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/immich-app/postgres"],
      versioning: "regex:^(?<compatibility>\\d+)-vectorchord(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-pgvector\\d+\\.(?<build>\\d+)\\.(?<revision>\\d+)$",
    },
    {
      description: [
        "CNPG Postgres majors (postgres-17-cluster) run an offline, one-way pg_upgrade of the shared cluster:",
        "every app's database is down, and plugins[0].parameters.serverName must go up in the same commit.",
        "Approve on the Dependency Dashboard only after the cloudnative-pg/cloudnative-pg release notes",
        "for the operator version we run list support for that Postgres major (#2905: PG 19 vs operator 1.30.2).",
      ],
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      description: [
        "castopod MariaDB stays on the LTS line (12.3, since 986c9079). 13.x is the rolling line (#2939).",
        "Raise the cap when the next LTS ships (supportType in MariaDB/mariadb-docker versions.json).",
      ],
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/library/mariadb"],
      allowedVersions: "<13",
    },
    {
      description: [
        "kopia/kopia (kopia-ui) also publishes nightly tags like 20261103.0.2044 and `unstable`,",
        "which sort above the releases and also look like X.Y.Z. Allow only a release tag",
        "(a major of 1-3 digits). Keep it at the kopia version of the Kopiur mover (kopiur .mise/config.toml).",
      ],
      matchDatasources: ["docker"],
      matchPackageNames: ["kopia/kopia"],
      allowedVersions: "/^\\d{1,3}\\.\\d+\\.\\d+$/",
    },
    {
      description: [
        "Override versioning for birdnet-go date-based release tags",
        "Upstream publishes dated release builds (20260716); the floating nightly/latest tags point at the same digest.",
        "Mapping Y/M/D to major/minor/patch keeps day-to-day bumps as fix(container) rather than a major every release.",
      ],
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/tphakala/birdnet-go"],
      versioning: "regex:^(?<major>\\d{4})(?<minor>\\d{2})(?<patch>\\d{2})$",
    },
    {
      description: [
        "forgejo-runner chart (forgejo-runner and tofu-runner) uses split tag:/digest: keys and renders repository@digest.",
        "helm-values only bumps tag: (silent no-op - PR #2500), so the split-digest customManager owns these.",
      ],
      matchManagers: ["helm-values"],
      matchFileNames: ["kubernetes/apps/forgejo/forgejo-runner/values.yaml", "kubernetes/apps/tofu/tofu-runner/values.yaml"],
      enabled: false,
    },
  ],
  customManagers: [
    {
      customType: "regex",
      description: [
        "Versions and images in GitHub workflows, marked with a '# renovate: datasource=... depName=...' comment on the line above.",
        "An image value is name:tag@sha256:digest - currentValue stops at '@' so the digest moves with the tag.",
      ],
      managerFilePatterns: ["/(^|/)\\.github/workflows/.+\\.ya?ml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+[\\w-]+: (?:[^\\s:@]+:)?(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?",
      ],
    },
    {
      customType: "regex",
      description: ["Process custom dependencies"],
      managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
    },
    {
      customType: "regex",
      description: [
        "Process cloudnative-pg imageName (postgres) and image-volume extension reference (postgis) fields.",
        "The value is tag@sha256:digest - currentValue must stop at '@' or the digest becomes part of the version and Renovate never offers an update.",
      ],
      managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
      matchStrings: [
        "(?:imageName|reference): (?<depName>(?<registryUrl>[^/]+)/(?<packageName>[^:]+)):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?",
      ],
      datasourceTemplate: "docker",
      versioningTemplate: "docker",
      registryUrlTemplate: "https://{{registryUrl}}",
    },
    {
      customType: "regex",
      description: [
        "Split tag:/digest: image keys (forgejo-runner chart renders repository@digest)",
        "Bumps tag and digest together; comment lines between repository and tag are allowed.",
      ],
      managerFilePatterns: ["/(^|/)kubernetes/apps/(forgejo/forgejo-runner|tofu/tofu-runner)/values\\.yaml$/"],
      matchStrings: [
        "repository: (?<depName>\\S+)\\n(?:[ \\t]*#.*\\n)*[ \\t]*tag: \"?(?<currentValue>[^\"\\s]+)\"?\\n[ \\t]*digest: \"?(?<currentDigest>sha256:[a-f0-9]{64})\"?",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: [
        "silence-operator image: the chart splits it into registry/name/tag, and helm-values only reads `repository`.",
        "The value is tag@sha256:digest; currentValue stops at '@' so the digest moves with the tag.",
      ],
      managerFilePatterns: ["/(^|/)kubernetes/apps/observability/silence-operator/values\\.yaml$/"],
      matchStrings: [
        "name: giantswarm/silence-operator\\n(?:[ \\t]*#.*\\n)*[ \\t]*tag: \"?(?<currentValue>[^\"\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})\"?",
      ],
      depNameTemplate: "gsoci.azurecr.io/giantswarm/silence-operator",
      datasourceTemplate: "docker",
      versioningTemplate: "docker",
    },
    {
      customType: "regex",
      description: [
        "tofu-runner job image lines inside the podSpecs block strings (image: repo:tag@digest).",
        "No other manager parses them: helm-values is off for this file and the generic manager would take repo:tag@digest as the version.",
        "The tag is the OpenTofu version built by .github/workflows/tofu-runner-image.yaml; currentValue stops at '@'.",
      ],
      managerFilePatterns: ["/(^|/)kubernetes/apps/tofu/tofu-runner/values\\.yaml$/"],
      matchStrings: [
        "image: (?<depName>ghcr\\.io/mebezac/tofu-runner):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})",
      ],
      datasourceTemplate: "docker",
      versioningTemplate: "docker",
    },
    {
      customType: "regex",
      description: [
        "Intel device plugin images: the charts build <hub>/<name>:<tag>, and helm-values only reads `repository`.",
        "The value is tag@sha256:digest; currentValue stops at '@' so the digest moves with the tag.",
      ],
      managerFilePatterns: ["/(^|/)kubernetes/apps/kube-system/intel-gpu/values\\.yaml$/"],
      matchStrings: [
        "hub: intel\\n(?:[ \\t]*#.*\\n)*[ \\t]*tag: \"?(?<currentValue>[^\"\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})\"?",
      ],
      depNameTemplate: "intel/intel-gpu-plugin",
      datasourceTemplate: "docker",
      versioningTemplate: "docker",
    },
    {
      customType: "regex",
      description: ["Intel device plugin operator image in the intel-gpu Argo app valuesObject (hub + tag, see above)."],
      managerFilePatterns: ["/(^|/)kubernetes/argo/apps/kube-system/intel-gpu\\.yaml$/"],
      matchStrings: [
        "hub: intel\\n(?:[ \\t]*#.*\\n)*[ \\t]*tag: \"?(?<currentValue>[^\"\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})\"?",
      ],
      depNameTemplate: "intel/intel-deviceplugin-operator",
      datasourceTemplate: "docker",
      versioningTemplate: "docker",
    },
    {
      customType: "regex",
      description: [
        "democratic-csi images: the chart takes registry (the full image name) + tag, and helm-values only reads `repository`.",
        "The value is tag@sha256:digest; currentValue stops at '@' so the digest moves with the tag.",
      ],
      managerFilePatterns: ["/(^|/)kubernetes/apps/storage/democratic-csi-[\\w-]+/values\\.yaml$/"],
      matchStrings: [
        "registry: (?<depName>\\S+)\\n(?:[ \\t]*#.*\\n)*[ \\t]*tag: \"?(?<currentValue>[^\"\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})\"?",
      ],
      datasourceTemplate: "docker",
      versioningTemplate: "docker",
    },
    {
      customType: "regex",
      description: [
        "longhorn and csi-driver-smb images: their value keys (image.longhorn.manager, image.csi.attacher, image.smb, ...) do not end in 'image',",
        "so the helm-values heuristic skips them. The value is tag@sha256:digest; currentValue stops at '@' so the digest moves with the tag.",
      ],
      managerFilePatterns: ["/(^|/)kubernetes/apps/(longhorn-system/longhorn|kube-system/csi-driver-smb)/values\\.yaml$/"],
      matchStrings: [
        "repository: (?<depName>\\S+)\\n(?:[ \\t]*#.*\\n)*[ \\t]*tag: \"?(?<currentValue>[^\"\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})\"?",
      ],
      datasourceTemplate: "docker",
      versioningTemplate: "docker",
    },
    {
      customType: "regex",
      description: ["ARG pins with a '# renovate: datasource=... depName=...' comment in our own Dockerfiles (containers/*)"],
      managerFilePatterns: ["/(^|/)containers/.+/Dockerfile$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nARG \\S+=(?<currentValue>\\S+)",
        // Upstream with no tags: pin a commit, track a branch head.
        "# renovate: datasource=(?<datasource>git-refs) depName=(?<depName>\\S+) branch=(?<currentValue>\\S+)\\nARG \\S+=(?<currentDigest>[0-9a-f]{40})",
      ],
    },
  ],
}
