{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    ":automergeBranch",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":semanticCommits",
    ":separatePatchReleases",
  ],
  dependencyDashboard: true,
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  suppressNotifications: ["prEditedNotification", "prIgnoreNotification"],
  schedule: ["every weekend"],
  ignorePaths: ["**/*.sops.*"],
  argocd: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  helmfile: {
    managerFilePatterns: ["/(^|/)helmfile\\.ya?ml(?:\\.j2)?$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
  },
  kustomize: {
    managerFilePatterns: ["/(^|/)kustomization\\.ya?ml(?:\\.j2)?$/"],
  },
  pip_requirements: {
    managerFilePatterns: [
      "/(^|/)[\\w-]*requirements(-\\w+)?\\.(txt|pip)(?:\\.j2)?$/",
    ],
  },
  packageRules: [
    {
      description: ["Auto-merge GitHub Actions for minor and patch"],
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
      matchUpdateTypes: ["minor", "patch"],
    },
    {
      description: [
        "Argo Operator Group",
        "github-releases pulls in the argocd CLI (aqua:argoproj/argo-cd in .mise.toml) so it tracks the server.",
      ],
      groupName: "Argo Operator",
      matchDatasources: ["docker", "github-releases"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: ["/argo-cd/"],
    },
    {
      description: ["Talos Group"],
      groupName: "Talos",
      matchDatasources: ["docker", "github-releases"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: ["/siderolabs/talosctl/", "/siderolabs/installer/", "/siderolabs/talos/"],
    },
    {
      description: [
        "Kubernetes Group",
        "kubelet (topf.yaml kubernetesVersion) and the kubectl client move together, as in commit 1ac21971.",
        "Merging does NOT upgrade the cluster - run `task talos:upgrade-k8s` (dry-run first) before any topf apply.",
      ],
      groupName: "Kubernetes",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: ["/siderolabs/kubelet/", "aqua:kubernetes/kubectl"],
    },
    {
      description: [
        "n8n publishes its beta channel as plain semver docker tags (GH pre-releases), so Renovate",
        "offers them as normal updates - twice we had to hand-pin back to stable (ac5dde00, c3c9e218).",
        "Approve on the Dependency Dashboard only once the target is GH 'Latest' (= the :stable docker tag).",
      ],
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/n8n-io/n8n"],
      dependencyDashboardApproval: true,
    },
    {
      description: [
        "Envoy Gateway Group",
        "Envoy Gateway bundles a specific Gateway API version; kubernetes-sigs/gateway-api",
        "(gateway-api-crds app) must match it, so both charts and the CRDs land in one PR.",
        "Before merging, check the EG release notes for the bundled Gateway API version.",
      ],
      groupName: "Envoy Gateway",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: ["/envoyproxy/gateway-helm/", "/envoyproxy/gateway-crds-helm/", "kubernetes-sigs/gateway-api"],
    },
    {
      description: [
        "The argocd manager also reads gateway-api-crds.yaml (git repoURL + targetRevision) under the",
        "depName https://github.com/kubernetes-sigs/gateway-api, which opens a duplicate PR that escapes",
        "the Envoy Gateway group. The `# renovate:` regex comment in that file is the one source of truth.",
      ],
      matchManagers: ["argocd"],
      matchFileNames: ["kubernetes/argo/apps/kube-system/gateway-api-crds.yaml"],
      enabled: false,
    },
    {
      description: [
        "Intel Device Plugins Group",
        "operator >=0.37.1 rejects a plugin image older than itself, so a lone operator bump fails the sync.",
      ],
      groupName: "Intel Device Plugins",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: ["intel-device-plugins-operator", "intel-device-plugins-gpu"],
    },
    {
      description: ["Network Optimizer Group", "network-optimizer and speedtest ship in lockstep from one compose file."],
      groupName: "Network Optimizer",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: ["/ozark-connect/"],
    },
    {
      description: [
        "VictoriaLogs Group",
        "The server and vlagent images are pinned in values.yaml, so chart bumps no longer move them;",
        "keep both charts and both images on one VictoriaLogs version.",
      ],
      groupName: "VictoriaLogs",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: ["victoria-logs-single", "victoria-logs-collector", "/victoriametrics/victoria-logs/", "/victoriametrics/vlagent/"],
    },
    {
      description: [
        "External DNS Group",
        "The image is pinned in all three external-dns values.yaml, so chart bumps no longer move it.",
      ],
      groupName: "External DNS",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      matchPackageNames: ["external-dns", "/external-dns/external-dns/"],
    },
    {
      matchDatasources: ["docker"],
      matchUpdateTypes: ["major"],
      commitMessagePrefix: "feat(container)!: ",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: " ( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      semanticCommitScope: "container",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["docker"],
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      semanticCommitScope: "container",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      semanticCommitType: "chore",
      semanticCommitScope: "container",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentDigestShort}} → {{newDigestShort}} )",
    },
    {
      matchDatasources: ["helm"],
      matchUpdateTypes: ["major"],
      commitMessagePrefix: "feat(helm)!: ",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["helm"],
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      semanticCommitScope: "helm",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["helm"],
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      semanticCommitScope: "helm",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["github-releases", "github-tags"],
      matchUpdateTypes: ["major"],
      commitMessagePrefix: "feat(github-release)!: ",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["github-releases", "github-tags"],
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      semanticCommitScope: "github-release",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchDatasources: ["github-releases", "github-tags"],
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      semanticCommitScope: "github-release",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["major"],
      commitMessagePrefix: "feat(github-action)!: ",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat",
      semanticCommitScope: "github-action",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix",
      semanticCommitScope: "github-action",
      commitMessageTopic: "{{depName}}",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
    },
    {
      matchUpdateTypes: ["major"],
      labels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      labels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      labels: ["type/patch"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchDatasources: ["github-releases", "github-tags"],
      addLabels: ["renovate/github-release"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      description: ["Override versioning for calibre-web-automated"],
      matchDatasources: ["docker"],
      matchPackageNames: ["crocodilestick/calibre-web-automated"],
      versioning: "regex:^V(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      description: ["Override versioning for umami postgresql tags"],
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/umami-software/umami"],
      versioning: "regex:^postgresql-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      description: [
        "Override versioning for the immich postgres compound tag",
        "Tag shape: <pgmajor>-vectorchord<x.y.z>-pgvector<a.b.c>, e.g. 18-vectorchord0.5.3-pgvector0.8.1.",
        "Default docker versioning cannot parse this, so Renovate silently offered nothing at all.",
        "compatibility = the Postgres major. Renovate NEVER changes a compatibility value, so this",
        "  pins us to PG 18 and cannot propose an 18 -> 19 jump, which would need a pg_upgrade.",
        "major/minor/patch = the vectorchord version (the component that actually moves).",
        "build/revision = pgvector minor/patch. CAVEAT: pgvector's major is matched but not",
        "  captured because only two slots are left; it has always been 0. If pgvector ever ships",
        "  1.0.0, revisit this rule - ordering across that boundary would be wrong.",
      ],
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/immich-app/postgres"],
      versioning: "regex:^(?<compatibility>\\d+)-vectorchord(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-pgvector\\d+\\.(?<build>\\d+)\\.(?<revision>\\d+)$",
    },
    {
      description: [
        "Override versioning for birdnet-go date-based release tags",
        "Upstream publishes dated release builds (20260716); the floating nightly/latest tags point at the same digest.",
        "Mapping Y/M/D to major/minor/patch keeps day-to-day bumps as fix(container) rather than a major every release.",
      ],
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/tphakala/birdnet-go"],
      versioning: "regex:^(?<major>\\d{4})(?<minor>\\d{2})(?<patch>\\d{2})$",
    },
    {
      description: [
        "forgejo-runner chart uses split tag:/digest: keys and renders repository@digest.",
        "helm-values only bumps tag: (silent no-op - PR #2500), so the split-digest customManager owns these.",
      ],
      matchManagers: ["helm-values"],
      matchFileNames: ["kubernetes/apps/forgejo/forgejo-runner/values.yaml"],
      enabled: false,
    },
  ],
  customManagers: [
    {
      customType: "regex",
      description: ["Process custom dependencies"],
      managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
    },
    {
      customType: "regex",
      description: [
        "Process cloudnative-pg imageName (postgres) and image-volume extension reference (postgis) fields.",
        "The value is tag@sha256:digest - currentValue must stop at '@' or the digest becomes part of the version and Renovate never offers an update.",
      ],
      managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/"],
      matchStrings: [
        "(?:imageName|reference): (?<depName>(?<registryUrl>[^/]+)/(?<packageName>[^:]+)):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?",
      ],
      datasourceTemplate: "docker",
      versioningTemplate: "docker",
      registryUrlTemplate: "https://{{registryUrl}}",
    },
    {
      customType: "regex",
      description: [
        "Split tag:/digest: image keys (forgejo-runner chart renders repository@digest)",
        "Bumps tag and digest together; comment lines between repository and tag are allowed.",
      ],
      managerFilePatterns: ["/(^|/)kubernetes/apps/forgejo/forgejo-runner/values\\.yaml$/"],
      matchStrings: [
        "repository: (?<depName>\\S+)\\n(?:[ \\t]*#.*\\n)*[ \\t]*tag: \"?(?<currentValue>[^\"\\s]+)\"?\\n[ \\t]*digest: \"?(?<currentDigest>sha256:[a-f0-9]{64})\"?",
      ],
      datasourceTemplate: "docker",
    },
  ],
}
